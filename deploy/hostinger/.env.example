APP_NAME="TMTA System"
APP_ENV=production
# Copy the existing APP_KEY from your local .env privately when moving existing data.
APP_KEY=
APP_DEBUG=false
APP_URL=https://tmta-system.io
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Use the database host and full prefixed names shown in hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_HOSTINGER_DATABASE
DB_USERNAME=REPLACE_WITH_HOSTINGER_USERNAME
DB_PASSWORD="REPLACE_WITH_HOSTINGER_PASSWORD"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Log transport does not send email; configure SMTP if email delivery is needed.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tmta-system.io"
MAIL_FROM_NAME="${APP_NAME}"

SUPERADMIN_MASTER_PASSWORD_HASH=
SUPERADMIN_MASTER_ACCOUNT_ID=
DELIVERY_MAP_REVERSE_URL=https://photon.komoot.io/reverse
# Enable only after registering this domain and providing your own reCAPTCHA keys.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAMES=tmta-system.io,www.tmta-system.io
VITE_APP_NAME="${APP_NAME}"
